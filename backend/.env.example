# Database
DATABASE_URL=postgresql://user:password@localhost:5432/sollux
# Unpooled connection used only by migrations. Locally the same as DATABASE_URL;
# on Neon, the same URL without "-pooler" in the host.
DIRECT_DATABASE_URL=postgresql://user:password@localhost:5432/sollux

# Redis
REDIS_URL=redis://localhost:6379

# Auth (Clerk)
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...

# Encryption — 32 bytes hex (openssl rand -hex 32)
ENCRYPTION_KEY=your_32_byte_hex_encryption_key_here

# AWS S3
AWS_ACCESS_KEY_ID=your_key
AWS_SECRET_ACCESS_KEY=your_secret
AWS_S3_BUCKET=sollux-documents
AWS_REGION=us-west-2

# Anthropic (Claude API)
ANTHROPIC_API_KEY=sk-ant-...
# Optional: which Claude models to use (defaults shown). CLAUDE_FALLBACK_MODEL=none turns the fallback off.
# CLAUDE_MODEL=claude-sonnet-5
# CLAUDE_FALLBACK_MODEL=claude-opus-5-5

# Shared secret for the nightly auditor's quality report (GET /api/audit/report).
# Generate with `openssl rand -hex 32`; set the same value as the AUDIT_TOKEN
# secret in the GitHub repo so the auditor workflow can read the report.
AUDIT_TOKEN=

# RentCast (property records + automated valuation) — sign up at rentcast.io
RENTCAST_API_KEY=your_rentcast_key

# Gmail OAuth
GMAIL_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your_google_client_secret
GMAIL_REDIRECT_URI=http://localhost:3001/api/gmail/callback

# Google Drive OAuth — reuses the same GMAIL_CLIENT_ID/SECRET (same Google
# Cloud OAuth app); add this redirect URI and the Drive API in Google Cloud
# Console, then add drive.readonly as an authorized scope.
DRIVE_REDIRECT_URI=http://localhost:3001/api/drive/callback

# Twilio (SMS)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# SendGrid (email)
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxx
SENDGRID_FROM_EMAIL=noreply@sollux.net
SENDGRID_FROM_NAME=Sollux

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Monthly prices for the three plans (lib/plans.ts)
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_PORTFOLIO=price_...

# App
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173
JWT_SECRET=your_jwt_secret_at_least_32_chars

# Claude spend (ai/meter.ts). Dollars per month for the whole app ("none" = no cap);
# per account; and the most one portal-agent run may spend before it stops.
AI_MONTHLY_BUDGET=25
AI_USER_MONTHLY_BUDGET=
PORTAL_RUN_MAX_USD=0.75

# Rent collection (services/rentCollection.ts): Stripe Connect Express. The
# webhook above also receives rent payments; send it checkout.session.*,
# payment_intent.* and customer.subscription.* events. Owners' account
# updates come from a separate Connect endpoint with its own secret:
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...
