// Sollux — Prisma Schema
// PostgreSQL 15

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── USERS ───────────────────────────────────────────────
model User {
  id                 String               @id @default(cuid())
  email              String               @unique
  passwordHash       String?
  fullName           String
  phone              String?
  subscriptionTier   SubscriptionTier     @default(BASIC)
  stripeCustomerId   String?
  clerkUserId        String?              @unique
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  properties              Property[]
  notificationPreferences NotificationPreference[]
  gmailTokens             GmailToken[]
  driveTokens             DriveToken[]
  paymentRecipient        PaymentRecipient?
  bankAccounts            BankAccount[]
  plaidItems              PlaidItem[]
  otherIncome             OtherIncome[]

  @@map("users")
}

enum SubscriptionTier {
  BASIC
  PRO
  BUSINESS
}

// ─── PROPERTIES ──────────────────────────────────────────
model Property {
  id               String         @id @default(cuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Basic info
  nickname         String?
  address          String         // addressLine1
  addressLine2     String?
  city             String
  county           String?
  state            String
  zip              String
  country          String         @default("US")
  region           String?        // freeform grouping, e.g. "Imperial County", "Oceanside"
  // Classification
  type             PropertyType
  status           PropertyStatus @default(ACTIVE)
  // Acquisition
  acquisitionDate  DateTime?
  acquisitionPrice Decimal?       @db.Decimal(14, 2)
  ownerEntity      String?
  notes            String?
  // Valuation
  estimatedValue   Decimal?       @db.Decimal(14, 2)
  landValue        Decimal?       @db.Decimal(14, 2)
  valuationDate    DateTime?
  valuationNotes   String?
  lotSqft          Int?
  parcelGroupName  String?        // e.g. "514-518 E St" for adjacent grouped parcels
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  // Utility intelligence (existing Sollux)
  utilityAccounts UtilityAccount[]
  insights        AIInsight[]
  // Property management (ported from Mgmt)
  units           Unit[]
  expenses        Expense[]
  loans           Loan[]
  insurance       InsurancePolicy[]
  taxAssessments  TaxAssessment[]
  improvements    Improvement[]
  legalMatters    LegalMatter[]

  @@index([userId, state])
  @@map("properties")
}

enum PropertyType {
  PRIMARY
  RENTAL
  INVESTMENT
  COMMERCIAL
  RESIDENTIAL_SINGLE
  RESIDENTIAL_MULTI
  LAND
  GOLF_COURSE
  OTHER
}

enum PropertyStatus {
  ACTIVE
  SOLD
  UNDER_CONTRACT
  INACTIVE
}

// ─── UTILITY ACCOUNTS ────────────────────────────────────
model UtilityAccount {
  id                    String          @id @default(cuid())
  propertyId            String
  property              Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  providerName          String
  providerSlug          String
  accountNumber         String?         // last 4 only
  accountNumberEnc      String?         // AES-256 encrypted
  usernameEnc           String?
  passwordEnc           String?
  loginUrl              String?
  category              UtilityCategory
  notes                 String?
  syncEnabled           Boolean         @default(true)
  isActive              Boolean         @default(true)
  lastSyncedAt          DateTime?
  lastSyncStatus        SyncStatus?
  lastSyncError         String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  statements   Statement[]
  payments     Payment[]
  insights     AIInsight[]
  paymentPlan  PaymentPlan?
  loan         Loan?

  @@map("utility_accounts")
}

enum UtilityCategory {
  ELECTRIC
  GAS
  WATER
  SEWER
  TRASH
  SOLAR
  INTERNET
  PHONE
  INSURANCE
  HOA
  TAXES
  OTHER
}

enum SyncStatus {
  SUCCESS
  FAILED
  PENDING
  PARTIAL
}

// ─── STATEMENTS ──────────────────────────────────────────
model Statement {
  id                 String          @id @default(cuid())
  utilityAccountId   String
  utilityAccount     UtilityAccount  @relation(fields: [utilityAccountId], references: [id], onDelete: Cascade)
  statementDate      DateTime
  dueDate            DateTime?
  billingPeriodStart DateTime?
  billingPeriodEnd   DateTime?
  amountDue          Decimal?        @db.Decimal(10, 2)
  amountPaid         Decimal?        @db.Decimal(10, 2)
  balance            Decimal?        @db.Decimal(10, 2)
  usageValue         Decimal?        @db.Decimal(10, 3)
  usageUnit          String?
  ratePlan           String?
  pdfS3Key           String?
  pdfUrl             String?
  rawDataJson        Json?
  sourceType         StatementSource @default(SCRAPER)
  createdAt          DateTime        @default(now())

  payments Payment[]

  @@map("statements")
}

enum StatementSource {
  SCRAPER
  EMAIL
  MANUAL
}

// ─── UTILITY PAYMENTS ────────────────────────────────────
model Payment {
  id                 String         @id @default(cuid())
  utilityAccountId   String
  utilityAccount     UtilityAccount @relation(fields: [utilityAccountId], references: [id], onDelete: Cascade)
  statementId        String?
  statement          Statement?     @relation(fields: [statementId], references: [id])
  amount             Decimal        @db.Decimal(10, 2)
  paymentDate        DateTime
  confirmationNumber String?
  paymentMethod      String?
  status             PaymentStatus  @default(PAID)
  notes              String?
  createdAt          DateTime       @default(now())

  @@map("payments")
}

enum PaymentStatus {
  PAID
  PENDING
  FAILED
  PARTIAL
}

// ─── AI INSIGHTS ─────────────────────────────────────────
model AIInsight {
  id               String          @id @default(cuid())
  propertyId       String
  property         Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  utilityAccountId String?
  utilityAccount   UtilityAccount? @relation(fields: [utilityAccountId], references: [id])
  insightType      InsightType
  severity         InsightSeverity
  title            String
  body             String
  recommendation   String?
  potentialSavings Decimal?        @db.Decimal(10, 2)
  isRead           Boolean         @default(false)
  isDismissed      Boolean         @default(false)
  expiresAt        DateTime?
  createdAt        DateTime        @default(now())

  @@map("ai_insights")
}

enum InsightType {
  ANOMALY
  SAVINGS
  REMINDER
  INFO
  OUTAGE
}

enum InsightSeverity {
  INFO
  WARNING
  ALERT
}

// ─── NOTIFICATION PREFERENCES ────────────────────────────
model NotificationPreference {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel       NotifChannel
  eventType     String
  thresholdDays Int         @default(5)
  isEnabled     Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([userId, channel, eventType])
  @@map("notification_preferences")
}

enum NotifChannel {
  EMAIL
  SMS
  PUSH
}

// ─── GMAIL TOKENS ────────────────────────────────────────
model GmailToken {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  email        String   @unique
  label        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, email])
  @@map("gmail_tokens")
}

// ─── DRIVE TOKENS ────────────────────────────────────────
model DriveToken {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  email        String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, email])
  @@map("drive_tokens")
}

enum DriveImportStatus {
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
}

// A single "import this folder" run — tracks progress for large folders and
// holds the leftover statements the auto-matcher couldn't confidently file,
// staged in S3 under pending-review/ until a human resolves them via the
// normal Import Bills review screen.
model DriveImportJob {
  id              String            @id @default(cuid())
  userId          String
  driveTokenId    String
  folderName      String?
  status          DriveImportStatus @default(RUNNING)
  totalFiles      Int               @default(0)
  processedFiles  Int               @default(0)
  autoImported    Int               @default(0)
  needsReviewJson Json?
  errorLog        String?
  startedAt       DateTime          @default(now())
  finishedAt      DateTime?

  @@map("drive_import_jobs")
}

// ─── SYNC JOBS ───────────────────────────────────────────
model SyncJob {
  id               String     @id @default(cuid())
  utilityAccountId String
  status           SyncStatus @default(PENDING)
  startedAt        DateTime?
  completedAt      DateTime?
  error            String?
  statementsFound  Int        @default(0)
  paymentsFound    Int        @default(0)
  createdAt        DateTime   @default(now())

  @@map("sync_jobs")
}

// ─── PAYMENT PLANS ───────────────────────────────────────
model PaymentPlan {
  id               String            @id @default(cuid())
  utilityAccountId String            @unique
  utilityAccount   UtilityAccount    @relation(fields: [utilityAccountId], references: [id], onDelete: Cascade)
  totalAmount      Decimal           @db.Decimal(10, 2)
  remainingBalance Decimal           @db.Decimal(10, 2)
  monthlyAmount    Decimal           @db.Decimal(10, 2)
  startDate        DateTime
  endDate          DateTime?
  description      String?
  status           PaymentPlanStatus @default(ACTIVE)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@map("payment_plans")
}

enum PaymentPlanStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

// ─── PAYMENT RECIPIENT ───────────────────────────────────
// Who tenants pay rent to — used on 3-day notices and the rent roll.
model PaymentRecipient {
  id      String  @id @default(cuid())
  userId  String  @unique
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name    String
  phone   String?
  email   String?
  address String?

  @@map("payment_recipients")
}

// ─── UNITS ───────────────────────────────────────────────
model Unit {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unitLabel  String
  bedrooms   Float?
  bathrooms  Float?
  sqft       Int?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  leases Lease[]

  @@unique([propertyId, unitLabel])
  @@map("units")
}

// ─── TENANTS ─────────────────────────────────────────────
model Tenant {
  id       String @id @default(cuid())
  userId   String
  fullName String
  email    String?
  phone    String?
  address  String?
  notes    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leaseTenants LeaseTenant[]

  @@index([userId])
  @@map("tenants")
}

model LeaseTenant {
  id        String  @id @default(cuid())
  leaseId   String
  lease     Lease   @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  isPrimary Boolean @default(false)

  @@unique([leaseId, tenantId])
  @@map("lease_tenants")
}

// ─── LEASES ──────────────────────────────────────────────
model Lease {
  id                   String      @id @default(cuid())
  unitId               String
  unit                 Unit        @relation(fields: [unitId], references: [id], onDelete: Cascade)
  startDate            DateTime
  endDate              DateTime?
  rentAmount           Decimal     @db.Decimal(10, 2)
  section8Amount       Decimal?    @db.Decimal(10, 2)
  securityDeposit      Decimal?    @db.Decimal(10, 2)
  leaseType            LeaseType   @default(MONTH_TO_MONTH)
  status               LeaseStatus @default(ACTIVE)
  documentUrl          String?
  notes                String?
  arrearsBalance       Decimal     @default(0) @db.Decimal(10, 2)
  arrearsCaughtUpThrough DateTime?
  manualLikelihood     String?     // 'high' | 'medium' | 'low' | 'none' — overrides the automated delinquency score
  manualLikelihoodNote String?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  leaseTenants LeaseTenant[]
  rentPayments RentPayment[]
  rentNotices  RentNotice[]

  @@map("leases")
}

enum LeaseType {
  FIXED_TERM
  MONTH_TO_MONTH
}

enum LeaseStatus {
  ACTIVE
  ENDED
  PENDING
  TERMINATED
}

// ─── RENT PAYMENTS ───────────────────────────────────────
model RentPayment {
  id               String            @id @default(cuid())
  leaseId          String
  lease            Lease             @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  periodDate       DateTime
  amount           Decimal           @db.Decimal(10, 2)
  appliedToArrears Decimal           @default(0) @db.Decimal(10, 2)
  paidDate         DateTime
  method           RentPaymentMethod @default(OTHER)
  notes            String?
  createdAt        DateTime          @default(now())

  @@index([leaseId, periodDate])
  @@map("rent_payments")
}

enum RentPaymentMethod {
  CASH
  CHECK
  ZELLE
  ACH
  MONEY_ORDER
  CARD
  OTHER
}

// ─── RENT NOTICES (3-day) ────────────────────────────────
model RentNotice {
  id              String   @id @default(cuid())
  leaseId         String
  lease           Lease    @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  noticeDate      DateTime
  lineItems       Json     // [{ amount: number, dueDate: string }]
  totalDue        Decimal  @db.Decimal(10, 2)
  signedByName    String
  signedByPhone   String?
  signedByEmail   String?
  signedByAddress String?
  createdAt       DateTime @default(now())

  @@index([leaseId])
  @@map("rent_notices")
}

// ─── EXPENSES ────────────────────────────────────────────
model Expense {
  id          String          @id @default(cuid())
  propertyId  String
  property    Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  category    ExpenseCategory
  amount      Decimal         @db.Decimal(10, 2)
  date        DateTime
  vendor      String?
  description String?
  isCapEx     Boolean         @default(false)
  isPersonal  Boolean         @default(false)
  documentUrl String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([propertyId, date])
  @@map("expenses")
}

enum ExpenseCategory {
  UTILITIES
  REPAIRS_MAINTENANCE
  LANDSCAPING
  PROPERTY_MANAGEMENT
  LEGAL
  INSURANCE
  PROPERTY_TAX
  HOA
  MORTGAGE_DEBT_SERVICE
  CAPITAL_IMPROVEMENT
  SUPPLIES
  TRAVEL
  ADVERTISING
  OTHER
}

// ─── LOANS ───────────────────────────────────────────────
model Loan {
  id                 String          @id @default(cuid())
  propertyId         String?
  property           Property?       @relation(fields: [propertyId], references: [id])
  utilityAccountId   String?         @unique
  utilityAccount     UtilityAccount? @relation(fields: [utilityAccountId], references: [id], onDelete: SetNull)
  userId             String
  loanType           LoanType
  lender             String
  accountLast4       String?
  accountNumberEnc   String?         // AES-256 encrypted full account number
  originalAmount     Decimal?        @db.Decimal(14, 2)
  interestRate       Decimal?        @db.Decimal(6, 3)
  originationDate    DateTime?
  maturityDate       DateTime?
  monthlyPayment     Decimal?        @db.Decimal(10, 2)
  balloonPaymentAmount Decimal?      @db.Decimal(14, 2) // final lump-sum payoff, when it differs from the recurring monthlyPayment (interest-only/negative-am balloons)
  escrowAmount       Decimal?        @db.Decimal(10, 2) // taxes/insurance portion, on top of P&I
  currentBalance     Decimal?        @db.Decimal(14, 2)
  dueDay             Int?            // day of month payment is due, e.g. 1
  gracePeriodDays    Int?            // days after dueDay before a late fee applies
  notes                  String?
  paymentType            String          @default("PRINCIPAL_AND_INTEREST")
  paymentStructureChangedAt DateTime?     // when paymentType last changed, e.g. converted from P&I to interest-only
  prepaymentPenaltyJson  Json?
  // Variable-rate structure — e.g. "1% below Prime, resets annually".
  // rateType FIXED (default) means `interestRate` above is just a static
  // number entered/edited manually, same as always. rateType VARIABLE means
  // `interestRate` is instead kept in sync automatically: on each loan's
  // rate-adjustment anniversary, it's recomputed as (latest known value of
  // rateIndex from IndexRate) + rateMargin, and nextRateAdjustment advances
  // by rateAdjustmentMonths. See recalcVariableRate() in routes/loans.ts.
  rateType               String          @default("FIXED") // 'FIXED' | 'VARIABLE'
  rateIndex              String?         // e.g. 'PRIME' — must match an IndexRate.indexName
  rateMargin             Decimal?        @db.Decimal(6, 3) // signed: -1.0 = "1% below index", +2.0 = "2% above index"
  rateAdjustmentMonths   Int?            // how often the rate resets, e.g. 12 for annual
  nextRateAdjustment     DateTime?       // next date the rate is due to reset; advances each time it fires
  isPersonal             Boolean         @default(false)
  isActive               Boolean         @default(true)
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  loanPayments LoanPayment[]

  @@index([propertyId])
  @@index([userId])
  @@map("loans")
}

enum LoanType {
  MORTGAGE
  HELOC
  AUTO
  PERSONAL
  STUDENT
  INSTALLMENT_PLAN
  CREDIT_LINE
  SELLER_FINANCING
  DSCR
  COMMERCIAL
  HARD_MONEY
  OTHER
}

// ─── REFERENCE RATE HISTORY ────────────────────────────────
// User-logged history of a reference rate (e.g. WSJ Prime Rate) over time —
// Sollux has no live market data feed, so this is manually maintained.
// Variable-rate loans look up the most recent entry as of their rate-reset
// date to compute their new interestRate (see Loan.rateIndex/rateMargin).
model IndexRate {
  id            String   @id @default(cuid())
  userId        String
  indexName     String   // e.g. 'PRIME'
  rate          Decimal  @db.Decimal(6, 3)
  effectiveDate DateTime
  notes         String?
  createdAt     DateTime @default(now())

  @@index([userId, indexName, effectiveDate])
  @@map("index_rates")
}

model LoanPayment {
  id                 String      @id @default(cuid())
  loanId             String
  loan               Loan        @relation(fields: [loanId], references: [id], onDelete: Cascade)
  date               DateTime
  billAmount         Decimal?    @db.Decimal(10, 2)
  amount             Decimal     @db.Decimal(10, 2)
  lateFee            Decimal?    @db.Decimal(10, 2)
  status             BillStatus  @default(PAID)
  principal          Decimal?    @db.Decimal(10, 2)
  interest           Decimal?    @db.Decimal(10, 2)
  escrow             Decimal?    @db.Decimal(10, 2)
  balanceAfter       Decimal?    @db.Decimal(14, 2)
  confirmationNumber String?
  notes              String?

  @@index([loanId, date])
  @@map("loan_payments")
}

enum BillStatus {
  UNPAID
  PAID
  ON_PAYMENT_PLAN
  PAST_DUE
}

// ─── INSURANCE POLICIES ──────────────────────────────────
model InsurancePolicy {
  id               String           @id @default(cuid())
  propertyId       String
  property         Property         @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  carrier          String
  policyNumber     String?
  policyType       InsuranceType    @default(PROPERTY)
  premiumAmount    Decimal          @db.Decimal(10, 2)
  premiumFrequency PremiumFrequency @default(ANNUAL)
  effectiveDate    DateTime?
  expirationDate   DateTime?
  documentUrl      String?
  notes            String?
  isPersonal       Boolean          @default(false)
  isActive         Boolean          @default(true)

  @@index([propertyId])
  @@map("insurance_policies")
}

enum InsuranceType {
  PROPERTY
  LIABILITY
  FLOOD
  UMBRELLA
  OTHER
}

enum PremiumFrequency {
  MONTHLY
  ANNUAL
  SEMI_ANNUAL
}

// ─── TAX ASSESSMENTS ─────────────────────────────────────
model TaxAssessment {
  id               String    @id @default(cuid())
  propertyId       String
  property         Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  taxYear          String
  assessedValue    Decimal?  @db.Decimal(14, 2)
  annualTaxAmount  Decimal   @db.Decimal(12, 2)
  installment1Due  DateTime?
  installment2Due  DateTime?
  installment1Paid DateTime?
  installment2Paid DateTime?
  status           TaxStatus @default(UNPAID)
  notes            String?

  @@unique([propertyId, taxYear])
  @@map("tax_assessments")
}

enum TaxStatus {
  UNPAID
  PAID
  PARTIALLY_PAID
  DELINQUENT
}

// ─── IMPROVEMENTS / CAPEX ────────────────────────────────
model Improvement {
  id             String    @id @default(cuid())
  propertyId     String
  property       Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  description    String
  category       String?
  cost           Decimal   @db.Decimal(12, 2)
  contractor     String?
  startDate      DateTime?
  completionDate DateTime?
  documentUrl    String?
  notes          String?

  @@index([propertyId])
  @@map("improvements")
}

// ─── LEGAL MATTERS ───────────────────────────────────────
model LegalMatter {
  id          String      @id @default(cuid())
  propertyId  String?
  property    Property?   @relation(fields: [propertyId], references: [id])
  userId      String
  title       String
  matterType  String
  status      LegalStatus @default(OPEN)
  filedDate   DateTime?
  closedDate  DateTime?
  attorney    String?
  caseNumber  String?
  description String?
  documentUrl String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([propertyId])
  @@index([userId])
  @@map("legal_matters")
}

enum LegalStatus {
  OPEN
  CLOSED
  ON_HOLD
}

// ─── BANK ACCOUNTS ───────────────────────────────────────
model BankAccount {
  id             String          @id @default(cuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  plaidItemId    String?
  plaidItem      PlaidItem?      @relation(fields: [plaidItemId], references: [id])
  plaidAccountId String?         @unique
  name           String          // e.g. "Fahim Chase Checking", "Dad WF Savings"
  last4          String?         // e.g. "4821"
  bank           String?         // e.g. "Chase", "Wells Fargo"
  ownerLabel     String?         // e.g. "Farhan", "Joint", "LLC"
  accountType    BankAccountType @default(CHECKING)
  isActive       Boolean         @default(true)
  sortOrder      Int             @default(0)
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  balances BankBalance[]

  @@index([userId])
  @@index([plaidItemId])
  @@map("bank_accounts")
}

model PlaidItem {
  id              String      @id @default(cuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  plaidItemId     String      @unique
  accessTokenEnc  String
  institutionId   String
  institutionName String
  isActive        Boolean     @default(true)
  lastSyncedAt    DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  accounts BankAccount[]

  @@index([userId])
  @@map("plaid_items")
}

enum BankAccountType {
  CHECKING
  SAVINGS
  CREDIT_CARD
  CASH_POOL   // cash on hand, Venmo, etc.
}

model BankBalance {
  id            String      @id @default(cuid())
  bankAccountId String
  bankAccount   BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  balance       Decimal     @db.Decimal(12, 2)  // current/ledger balance
  available     Decimal?    @db.Decimal(12, 2)  // available (current minus pending)
  creditLimit   Decimal?    @db.Decimal(12, 2)
  asOfDate      DateTime    // always stored as midnight UTC for daily dedup
  source        String?     // "plaid" | "manual"
  notes         String?
  createdAt     DateTime    @default(now())

  @@unique([bankAccountId, asOfDate])
  @@map("bank_balances")
}

// ─── OTHER INCOME ────────────────────────────────────────
// Non-rent income: appliance biz, SSI/govt benefits, international transfers, etc.
model OtherIncome {
  id           String              @id @default(cuid())
  userId       String
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  category     OtherIncomeCategory
  description  String?
  amount       Decimal             @db.Decimal(10, 2)
  receivedDate DateTime
  method       String?             // cash, Zelle, Venmo, TapTap, check, etc.
  isRecurring  Boolean             @default(false)
  notes        String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([userId, receivedDate])
  @@map("other_income")
}

enum OtherIncomeCategory {
  APPLIANCE_SERVICE    // service call fee
  APPLIANCE_DELIVERY   // delivery fee
  APPLIANCE_SALE       // appliance sold
  GOVERNMENT_BENEFIT   // SSI, Section 8 admin fee, etc.
  INTERNATIONAL        // TapTap / Bangladesh remittance received back
  LOAN_RECEIVED        // personal loan received
  SECURITY_DEPOSIT     // deposit collected from new tenant
  DEPOSIT_REFUND_IN    // deposit returned that you previously paid
  LAUNDRY              // laundry machine income
  OTHER
}
