// Sollux — Prisma Schema
// PostgreSQL 15

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── USERS ───────────────────────────────────────────────
model User {
  id               String           @id @default(cuid())
  email            String           @unique
  passwordHash     String?
  fullName         String
  phone            String?
  subscriptionTier SubscriptionTier @default(BASIC)
  stripeCustomerId String?
  clerkUserId      String?          @unique
  // Shared ("family") access: when set, this user signs in with their own
  // credentials but operates on the owner's data. Every route scopes by the
  // resolved owner id, so members see and edit exactly the same records.
  // Owners have this null. One level only — a member cannot own members.
  ownerUserId      String?
  owner            User?            @relation("AccountMembers", fields: [ownerUserId], references: [id], onDelete: SetNull)
  // What counts as operating cost. A late fee and an arrears installment are
  // real money leaving the account, but neither is the cost of running the
  // property this month — so both are excluded by default and can be folded
  // back in for anyone who would rather see total cash out.
  includePenaltiesInOperating   Boolean @default(false)
  includePaymentPlanInOperating Boolean @default(false)
  members          User[]           @relation("AccountMembers")
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  invitesSent             AccountInvite[]
  properties              Property[]
  notificationPreferences NotificationPreference[]
  gmailTokens             GmailToken[]
  driveTokens             DriveToken[]
  paymentRecipient        PaymentRecipient?
  bankAccounts            BankAccount[]
  plaidItems              PlaidItem[]
  otherIncome             OtherIncome[]
  incomingTransactions    IncomingTransaction[]
  outgoingTransactions    OutgoingTransaction[]

  @@map("users")
}

enum SubscriptionTier {
  BASIC
  PRO
  BUSINESS
}

// Pending shared-access invite. The invitee signs up with their own login
// (email or phone); on their first authenticated request we match the invite
// and link them to the owner's account.
model AccountInvite {
  id               String    @id @default(cuid())
  ownerUserId      String
  owner            User      @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  email            String?
  phone            String?
  acceptedAt       DateTime?
  acceptedByUserId String?
  createdAt        DateTime  @default(now())

  @@index([email])
  @@index([phone])
  @@map("account_invites")
}

// ─── PROPERTIES ──────────────────────────────────────────
model Property {
  id               String         @id @default(cuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Basic info
  nickname         String?
  address          String // addressLine1
  addressLine2     String?
  city             String
  county           String?
  state            String
  zip              String
  country          String         @default("US")
  region           String? // freeform grouping, e.g. "Imperial County", "Oceanside"
  // Classification
  type             PropertyType
  status           PropertyStatus @default(ACTIVE)
  // Acquisition
  acquisitionDate  DateTime?
  acquisitionPrice Decimal?       @db.Decimal(14, 2)
  ownerEntity      String?
  notes            String?
  // Valuation
  estimatedValue   Decimal?       @db.Decimal(14, 2)
  landValue        Decimal?       @db.Decimal(14, 2)
  valuationDate    DateTime?
  valuationNotes   String?
  lotSqft          Int?
  parcelGroupName  String? // e.g. "514-518 E St" for adjacent grouped parcels
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  // Utility intelligence (existing Sollux)
  utilityAccounts        UtilityAccount[]
  insights               AIInsight[]
  // Property management (ported from Mgmt)
  units                  Unit[]
  expenses               Expense[]
  loans                  Loan[]
  insurance              InsurancePolicy[]
  taxAssessments         TaxAssessment[]
  improvements           Improvement[]
  legalMatters           LegalMatter[]
  reconciliationProfiles ReconciliationProfile[]
  documents              Document[]
  outgoingTransactions   OutgoingTransaction[]

  @@index([userId, state])
  @@map("properties")
}

enum PropertyType {
  PRIMARY
  RENTAL
  INVESTMENT
  COMMERCIAL
  MIXED_USE
  RESIDENTIAL_SINGLE
  RESIDENTIAL_MULTI
  LAND
  GOLF_COURSE
  OTHER
}

enum PropertyStatus {
  ACTIVE
  SOLD
  UNDER_CONTRACT
  INACTIVE
}

// ─── UTILITY ACCOUNTS ────────────────────────────────────
model UtilityAccount {
  id               String          @id @default(cuid())
  propertyId       String
  property         Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  providerName     String
  providerSlug     String
  accountNumber    String? // last 4 only
  accountNumberEnc String? // AES-256 encrypted
  usernameEnc      String?
  passwordEnc      String?
  loginUrl         String?
  category         UtilityCategory
  // Which unit this meter serves. A multi-unit property can carry several
  // meters for one utility — "IID ****8110" and "IID ****5855" are
  // indistinguishable without this. Null means it does not serve a single
  // unit; serviceLabel then says what it does serve.
  unitId           String?
  unit             Unit?           @relation(fields: [unitId], references: [id], onDelete: SetNull)
  // What this meter serves when it isn't one unit: "House meter", "Laundry
  // room", "Common area", "Irrigation". Free text because the list is
  // open-ended and varies by property.
  serviceLabel     String?
  notes            String?
  // How often this account actually bills. Most utilities are monthly, but an
  // insurance policy may bill once a term, and a policy paid up front bills
  // once and never again. Anything that reasons about a month's cost has to
  // know this: an annual premium of $2,040 is $170 a month, not $2,040, and a
  // once-a-term account with no bill this month is not a missing bill.
  billingCadence   BillingCadence  @default(MONTHLY)
  // Length of the term for a cadence of TERM — a 6-month policy is 6. Ignored
  // for the fixed cadences.
  termMonths       Int?
  // What a normal bill on this account looks like, for cadences that don't
  // produce one every month. Lets a monthly figure be derived before any
  // statement has been imported, and gives anomaly detection a baseline.
  expectedAmount   Decimal?        @db.Decimal(10, 2)
  // Rules you know that the statements do not say. Learned fee behaviour comes
  // from billing history, but a shutoff threshold appears only on a
  // disconnection notice, if at all — so it is recorded by hand. Anything set
  // here overrides what history infers, because you know the policy and the
  // history is only evidence of it.
  graceDays        Int?            // days after the due date before a fee applies
  lateFeeFixed     Decimal?        @db.Decimal(10, 2)
  lateFeePercent   Decimal?        @db.Decimal(5, 2)
  shutoffAfterDays Int?            // days past due before service is cut
  paymentRuleNotes String?
  syncEnabled      Boolean         @default(true)
  isActive         Boolean         @default(true)
  lastSyncedAt     DateTime?
  lastSyncStatus   SyncStatus?
  lastSyncError    String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  statements           Statement[]
  payments             Payment[]
  insights             AIInsight[]
  paymentPlan          PaymentPlan?
  loan                 Loan?
  insurancePolicy      InsurancePolicy?
  outgoingTransactions OutgoingTransaction[]

  @@map("utility_accounts")
}

/// How often an account bills. Drives the monthly-equivalent cost of a bill
/// that does not arrive monthly.
enum BillingCadence {
  MONTHLY
  /// Once every two months — EDCO and several haulers bill this way.
  BIMONTHLY
  QUARTERLY
  SEMI_ANNUAL
  ANNUAL
  /// Bills once per term of termMonths — the shape most insurance policies take.
  TERM
  /// Paid once, never recurring (a policy settled up front, a one-off permit).
  ONE_TIME
  /// Bills on no schedule worth modelling; treated as monthly for totals only
  /// when a statement actually exists.
  IRREGULAR
}

enum UtilityCategory {
  ELECTRIC
  GAS
  WATER
  SEWER
  TRASH
  SOLAR
  INTERNET
  PHONE
  INSURANCE
  HOA
  TAXES
  LOAN
  CREDIT_CARD
  OTHER
}

enum SyncStatus {
  SUCCESS
  FAILED
  PENDING
  PARTIAL
}

// ─── STATEMENTS ──────────────────────────────────────────
model Statement {
  id                   String          @id @default(cuid())
  utilityAccountId     String
  utilityAccount       UtilityAccount  @relation(fields: [utilityAccountId], references: [id], onDelete: Cascade)
  statementDate        DateTime
  dueDate              DateTime?
  billingPeriodStart   DateTime?
  billingPeriodEnd     DateTime?
  // amountDue = "Total due": this period's charges INCLUDING penalties/fees
  // but NOT including past due carried from prior periods.
  amountDue            Decimal?        @db.Decimal(10, 2)
  amountPaid           Decimal?        @db.Decimal(10, 2)
  balance              Decimal?        @db.Decimal(10, 2)
  // First-class columns for line items that used to live only inside
  // rawDataJson (scraper-specific keys like "penalties"/"pastDue") — kept
  // as real, queryable fields so manual entry, PDF import, and the fees
  // summary report all agree on one shape. Reads still fall back to the
  // matching rawDataJson key for older scraped statements that predate
  // these columns (see resolveStatementFields in statements.ts).
  // "Due w/o penalties and fees": this period's base charges only —
  // amountDue minus penaltiesFees. "Total due w/ past due" isn't stored;
  // it's amountDue + pastDueCarried, computed wherever it's displayed.
  chargesExcludingFees Decimal?        @db.Decimal(10, 2)
  penaltiesFees        Decimal?        @db.Decimal(10, 2)
  // An installment on an arrears payment plan charged within this bill. It is
  // repayment of an old debt, not what the property cost to run this month, so
  // it is held separately and left out of operating cost by default.
  paymentPlanAmount    Decimal?        @db.Decimal(10, 2)
  pastDueCarried       Decimal?        @db.Decimal(10, 2)
  notes                String?
  usageValue           Decimal?        @db.Decimal(10, 3)
  usageUnit            String?
  ratePlan             String?
  pdfS3Key             String?
  pdfUrl               String?
  rawDataJson          Json?
  // When a penalty lands if the bill goes unpaid, and what the bill becomes
  // then. Providers print both — a City of Brawley bill carries "Penalty Date
  // 9/16/2026" and "AMOUNT DUE AFTER 09/15/2026 $507.54" — and they are the
  // difference between predicting a late fee and guessing at one.
  // Aging as the provider reports it: { current, days30, days60, days90plus }.
  // Republic prints these buckets; they are a far better read of how deep
  // arrears run than a single past-due figure, and they can be checked against
  // the unpaid statements Sollux holds.
  agingBuckets         Json?
  penaltyDate          DateTime?
  amountAfterDueDate   Decimal?        @db.Decimal(10, 2)
  // A deposit or down payment taken at the start of a term, not a period's
  // charge. Kept as its own row so the PDF and the amount are on file, but
  // excluded from monthly totals and from per-month averages — otherwise the
  // month a policy starts looks like a cost spike and every average built on
  // it is wrong.
  isDownPayment        Boolean         @default(false)
  sourceType           StatementSource @default(SCRAPER)
  createdAt            DateTime        @default(now())

  payments Payment[]

  @@map("statements")
}

enum StatementSource {
  SCRAPER
  EMAIL
  MANUAL
}

// ─── UTILITY PAYMENTS ────────────────────────────────────
model Payment {
  id                 String         @id @default(cuid())
  utilityAccountId   String
  utilityAccount     UtilityAccount @relation(fields: [utilityAccountId], references: [id], onDelete: Cascade)
  statementId        String?
  statement          Statement?     @relation(fields: [statementId], references: [id])
  amount             Decimal        @db.Decimal(10, 2)
  paymentDate        DateTime
  confirmationNumber String?
  paymentMethod      String?
  status             PaymentStatus  @default(PAID)
  // Which of the owner's accounts the bill was paid from.
  bankAccountId      String?
  bankAccount        BankAccount?   @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  notes              String?
  createdAt          DateTime       @default(now())

  @@index([utilityAccountId, paymentDate])
  @@index([bankAccountId])
  @@map("payments")
}

enum PaymentStatus {
  PAID
  PENDING
  FAILED
  PARTIAL
}

// ─── AI INSIGHTS ─────────────────────────────────────────
model AIInsight {
  id               String          @id @default(cuid())
  propertyId       String
  property         Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  utilityAccountId String?
  utilityAccount   UtilityAccount? @relation(fields: [utilityAccountId], references: [id])
  insightType      InsightType
  severity         InsightSeverity
  title            String
  body             String
  recommendation   String?
  potentialSavings Decimal?        @db.Decimal(10, 2)
  isRead           Boolean         @default(false)
  isDismissed      Boolean         @default(false)
  expiresAt        DateTime?
  createdAt        DateTime        @default(now())

  @@map("ai_insights")
}

enum InsightType {
  ANOMALY
  SAVINGS
  REMINDER
  INFO
  OUTAGE
}

enum InsightSeverity {
  INFO
  WARNING
  ALERT
}

// ─── NOTIFICATION PREFERENCES ────────────────────────────
model NotificationPreference {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel       NotifChannel
  eventType     String
  thresholdDays Int          @default(5)
  isEnabled     Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([userId, channel, eventType])
  @@map("notification_preferences")
}

enum NotifChannel {
  EMAIL
  SMS
  PUSH
}

// ─── GMAIL TOKENS ────────────────────────────────────────
model GmailToken {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  email        String   @unique
  label        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, email])
  @@map("gmail_tokens")
}

// ─── DRIVE TOKENS ────────────────────────────────────────
model DriveToken {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  email        String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, email])
  @@map("drive_tokens")
}

enum DriveImportStatus {
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
}

// A single "import this folder" run — tracks progress for large folders and
// holds the leftover statements the auto-matcher couldn't confidently file,
// staged in S3 under pending-review/ until a human resolves them via the
// normal Import Bills review screen.
model DriveImportJob {
  id              String            @id @default(cuid())
  userId          String
  driveTokenId    String
  folderName      String?
  status          DriveImportStatus @default(RUNNING)
  totalFiles      Int               @default(0)
  processedFiles  Int               @default(0)
  autoImported    Int               @default(0)
  needsReviewJson Json?
  errorLog        String?
  startedAt       DateTime          @default(now())
  finishedAt      DateTime?

  @@map("drive_import_jobs")
}

// ─── SYNC JOBS ───────────────────────────────────────────
model SyncJob {
  id               String     @id @default(cuid())
  utilityAccountId String
  status           SyncStatus @default(PENDING)
  startedAt        DateTime?
  completedAt      DateTime?
  error            String?
  statementsFound  Int        @default(0)
  paymentsFound    Int        @default(0)
  createdAt        DateTime   @default(now())

  @@map("sync_jobs")
}

// ─── PAYMENT PLANS ───────────────────────────────────────
model PaymentPlan {
  id               String            @id @default(cuid())
  utilityAccountId String            @unique
  utilityAccount   UtilityAccount    @relation(fields: [utilityAccountId], references: [id], onDelete: Cascade)
  totalAmount      Decimal           @db.Decimal(10, 2)
  remainingBalance Decimal           @db.Decimal(10, 2)
  monthlyAmount    Decimal           @db.Decimal(10, 2)
  startDate        DateTime
  endDate          DateTime?
  description      String?
  status           PaymentPlanStatus @default(ACTIVE)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@map("payment_plans")
}

enum PaymentPlanStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

// ─── PAYMENT RECIPIENT ───────────────────────────────────
// Who tenants pay rent to — used on 3-day notices and the rent roll.
model PaymentRecipient {
  id      String  @id @default(cuid())
  userId  String  @unique
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name    String
  phone   String?
  email   String?
  address String?

  @@map("payment_recipients")
}

// ─── UNITS ───────────────────────────────────────────────
model Unit {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unitLabel  String
  bedrooms   Float?
  bathrooms  Float?
  sqft       Int?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  leases          Lease[]
  utilityAccounts UtilityAccount[]

  @@unique([propertyId, unitLabel])
  @@map("units")
}

// ─── TENANTS ─────────────────────────────────────────────
model Tenant {
  id        String   @id @default(cuid())
  userId    String
  fullName  String
  email     String?
  phone     String?
  address   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leaseTenants LeaseTenant[]

  @@index([userId])
  @@map("tenants")
}

model LeaseTenant {
  id        String  @id @default(cuid())
  leaseId   String
  lease     Lease   @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  isPrimary Boolean @default(false)

  @@unique([leaseId, tenantId])
  @@map("lease_tenants")
}

// ─── LEASES ──────────────────────────────────────────────
model Lease {
  id                     String      @id @default(cuid())
  unitId                 String
  unit                   Unit        @relation(fields: [unitId], references: [id], onDelete: Cascade)
  startDate              DateTime
  endDate                DateTime?
  rentAmount             Decimal     @db.Decimal(10, 2)
  section8Amount         Decimal?    @db.Decimal(10, 2)
  securityDeposit        Decimal?    @db.Decimal(10, 2)
  leaseType              LeaseType   @default(MONTH_TO_MONTH)
  status                 LeaseStatus @default(ACTIVE)
  documentUrl            String?
  notes                  String?
  arrearsBalance         Decimal     @default(0) @db.Decimal(10, 2)
  // Day of month rent is due (1-31, default 1). Current-month rent is NOT
  // counted as arrears until this day passes unpaid — see accrueOverdueRent.
  rentDueDay             Int?
  // Last period already rolled into arrearsBalance, so accrual is idempotent.
  arrearsCaughtUpThrough DateTime?
  manualLikelihood       String? // 'high' | 'medium' | 'low' | 'none' — overrides the automated delinquency score
  manualLikelihoodNote   String?
  // Next scheduled rent increase — flexible: a date plus whichever of
  // {new amount, percent, note} the user filled in. amount takes precedence
  // over percent for display; note alone is a plain reminder.
  nextIncreaseDate       DateTime?
  nextIncreaseAmount     Decimal?    @db.Decimal(10, 2)
  nextIncreasePercent    Float?
  nextIncreaseNote       String?
  // Late fee: either a flat amount or a percent of rent (percent wins when set).
  // graceDays = days after the due day before the fee applies.
  lateFeeAmount          Decimal?    @db.Decimal(10, 2)
  lateFeePercent         Float?
  lateFeeGraceDays       Int?
  // Commercial leases: the business/entity on the lease alongside the person.
  businessName           String?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  leaseTenants         LeaseTenant[]
  rentPayments         RentPayment[]
  rentNotices          RentNotice[]
  rentChanges          RentChange[]
  scheduledIncreases   ScheduledRentIncrease[]
  utilityCharges       LeaseUtilityCharge[]
  paymentAliases       LeasePaymentAlias[]
  legalMatters         LegalMatter[]
  incomingTransactions IncomingTransaction[]

  @@map("leases")
}

enum LeaseType {
  FIXED_TERM
  MONTH_TO_MONTH
}

enum LeaseStatus {
  ACTIVE
  ENDED
  PENDING
  TERMINATED
}

// ─── RENT CHANGES (increase/decrease history) ────────────
// One row per time the monthly rent changed on a lease. Auto-created when
// rentAmount is edited, and manually addable to backfill past increases.
model RentChange {
  id             String   @id @default(cuid())
  leaseId        String
  lease          Lease    @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  effectiveDate  DateTime
  previousAmount Decimal? @db.Decimal(10, 2)
  newAmount      Decimal  @db.Decimal(10, 2)
  note           String?
  createdAt      DateTime @default(now())

  @@index([leaseId, effectiveDate])
  @@map("rent_changes")
}

// ─── SCHEDULED RENT INCREASES (future/planned) ───────────
// Multiple upcoming increases per lease. Each is a plan: an effective date
// plus either an explicit new amount or a percent (applied to current rent).
model ScheduledRentIncrease {
  id            String   @id @default(cuid())
  leaseId       String
  lease         Lease    @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  effectiveDate DateTime
  newAmount     Decimal? @db.Decimal(10, 2)
  percent       Float? // single percent, or the low end of a range
  percentMax    Float? // set for a range (percent..percentMax), e.g. 6%–10%
  note          String?
  applied       Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([leaseId, effectiveDate])
  @@map("scheduled_rent_increases")
}

// ─── LEASE UTILITY CHARGES ───────────────────────────────
// Portion of a tenant's monthly payment that is a utility reimbursement
// rather than rent (e.g. "$100 toward water"). Lease.rentAmount remains the
// TOTAL the tenant pays (what Budget/Rent Roll/P&L collect on); base rent is
// derived as rentAmount minus the sum of these charges. Leases with utilities
// included in rent simply have no rows here.
// Names a lease's rent may legitimately arrive under: a spouse, an adult
// child, an employer, a housing authority. Bank descriptors carry the sender's
// name, not the tenant's, so without these a Zelle from "JOSE CONTRERAS" for
// Cristina's unit never matches.
model LeasePaymentAlias {
  id        String   @id @default(cuid())
  leaseId   String
  lease     Lease    @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  name      String
  note      String?
  createdAt DateTime @default(now())

  @@index([leaseId])
  @@map("lease_payment_aliases")
}

model LeaseUtilityCharge {
  id        String   @id @default(cuid())
  leaseId   String
  lease     Lease    @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  category  String // UtilityCategory value: WATER, ELECTRIC, GAS, TRASH, ...
  amount    Decimal  @db.Decimal(10, 2)
  note      String?
  createdAt DateTime @default(now())

  @@index([leaseId])
  @@map("lease_utility_charges")
}

// ─── RENT PAYMENTS ───────────────────────────────────────
model RentPayment {
  id               String            @id @default(cuid())
  leaseId          String
  lease            Lease             @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  periodDate       DateTime
  amount           Decimal           @db.Decimal(10, 2)
  appliedToArrears Decimal           @default(0) @db.Decimal(10, 2)
  paidDate         DateTime
  method           RentPaymentMethod @default(OTHER)
  // PENDING money is committed but not received: it must not count toward the
  // month's rent or pay down arrears until it actually arrives.
  status           RentPaymentStatus @default(RECEIVED)
  // When a pending payment is expected to disburse.
  expectedDate     DateTime?
  // Which of the owner's accounts the money landed in. Set for BANK_DEPOSIT,
  // and optionally for any other method the owner wants to attribute. Kept
  // nullable and SetNull so removing a bank account never destroys payments.
  bankAccountId    String?
  bankAccount      BankAccount?      @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  notes            String?
  createdAt        DateTime          @default(now())

  @@index([leaseId, periodDate])
  @@index([bankAccountId])
  @@map("rent_payments")
}

enum RentPaymentStatus {
  PENDING
  RECEIVED
}

enum RentPaymentMethod {
  CASH
  CHECK
  ZELLE
  ACH
  MONEY_ORDER
  CARD
  VENMO
  PAYPAL
  CASH_APP
  APPLE_CASH
  // Housing Choice Voucher — the housing authority's portion, paid directly
  // to the landlord and separate from the tenant's share.
  SECTION_8
  // ERAP, county and charity programs. Often approved long before the money
  // lands, which is why RentPayment carries a status.
  RENTAL_ASSISTANCE
  // Handed over / deposited directly into one of the owner's accounts. Which
  // account is recorded on RentPayment.bankAccountId.
  BANK_DEPOSIT
  OTHER
}

// ─── RENT NOTICES (3-day) ────────────────────────────────
model RentNotice {
  id              String   @id @default(cuid())
  leaseId         String
  lease           Lease    @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  noticeDate      DateTime
  lineItems       Json // [{ amount: number, dueDate: string }]
  totalDue        Decimal  @db.Decimal(10, 2)
  signedByName    String
  signedByPhone   String?
  signedByEmail   String?
  signedByAddress String?
  createdAt       DateTime @default(now())

  @@index([leaseId])
  @@map("rent_notices")
}

// ─── EXPENSES ────────────────────────────────────────────
model Expense {
  id          String          @id @default(cuid())
  // userId makes ownership independent of having a property — a personal
  // expense (isPersonal true) can have propertyId null entirely, same
  // pattern Loan already uses for personal (non-real-estate) loans.
  userId      String
  propertyId  String?
  property    Property?       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  category    ExpenseCategory
  amount      Decimal         @db.Decimal(10, 2)
  date        DateTime
  vendor      String?
  description String?
  isCapEx     Boolean         @default(false)
  isPersonal  Boolean         @default(false)
  documentUrl String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([propertyId, date])
  @@index([userId, date])
  @@map("expenses")
}

enum ExpenseCategory {
  UTILITIES
  REPAIRS_MAINTENANCE
  LANDSCAPING
  PROPERTY_MANAGEMENT
  LEGAL
  INSURANCE
  PROPERTY_TAX
  HOA
  MORTGAGE_DEBT_SERVICE
  CAPITAL_IMPROVEMENT
  SUPPLIES
  TRAVEL
  ADVERTISING
  OTHER
  // Personal (isPersonal: true) categories — shown on the dedicated
  // Personal Expenses page, distinct from the property-level categories
  // above (e.g. AUTO_INSURANCE vs. the landlord-policy INSURANCE).
  AUTO_LOAN
  AUTO_INSURANCE
  CREDIT_CARD
  MEDICAL
  PHONE
  STUDENT_LOAN
  LIFE_INSURANCE
  SUBSCRIPTIONS
}

// ─── LOANS ───────────────────────────────────────────────
model Loan {
  id                        String          @id @default(cuid())
  propertyId                String?
  property                  Property?       @relation(fields: [propertyId], references: [id])
  utilityAccountId          String?         @unique
  utilityAccount            UtilityAccount? @relation(fields: [utilityAccountId], references: [id], onDelete: SetNull)
  userId                    String
  loanType                  LoanType
  lender                    String
  accountLast4              String?
  accountNumberEnc          String? // AES-256 encrypted full account number
  originalAmount            Decimal?        @db.Decimal(14, 2)
  interestRate              Decimal?        @db.Decimal(6, 3)
  originationDate           DateTime?
  maturityDate              DateTime?
  monthlyPayment            Decimal?        @db.Decimal(10, 2)
  balloonPaymentAmount      Decimal?        @db.Decimal(14, 2) // final lump-sum payoff, when it differs from the recurring monthlyPayment (interest-only/negative-am balloons)
  escrowAmount              Decimal?        @db.Decimal(10, 2) // taxes/insurance portion, on top of P&I
  currentBalance            Decimal?        @db.Decimal(14, 2)
  dueDay                    Int? // day of month payment is due, e.g. 1
  gracePeriodDays           Int? // days after dueDay before a late fee applies
  notes                     String?
  paymentType               String          @default("PRINCIPAL_AND_INTEREST")
  paymentStructureChangedAt DateTime? // when paymentType last changed, e.g. converted from P&I to interest-only
  prepaymentPenaltyJson     Json?
  // Variable-rate structure — e.g. "1% below Prime, resets annually".
  // rateType FIXED (default) means `interestRate` above is just a static
  // number entered/edited manually, same as always. rateType VARIABLE means
  // `interestRate` is instead kept in sync automatically: on each loan's
  // rate-adjustment anniversary, it's recomputed as (latest known value of
  // rateIndex from IndexRate) + rateMargin, and nextRateAdjustment advances
  // by rateAdjustmentMonths. See recalcVariableRate() in routes/loans.ts.
  rateType                  String          @default("FIXED") // 'FIXED' | 'VARIABLE'
  rateIndex                 String? // e.g. 'PRIME' — must match an IndexRate.indexName
  rateMargin                Decimal?        @db.Decimal(6, 3) // signed: -1.0 = "1% below index", +2.0 = "2% above index"
  rateAdjustmentMonths      Int? // how often the rate resets, e.g. 12 for annual
  nextRateAdjustment        DateTime? // next date the rate is due to reset; advances each time it fires
  isPersonal                Boolean         @default(false)
  isActive                  Boolean         @default(true)
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt

  loanPayments   LoanPayment[]
  loanExtensions LoanExtension[]

  @@index([propertyId])
  @@index([userId])
  @@map("loans")
}

enum LoanType {
  MORTGAGE
  HELOC
  AUTO
  PERSONAL
  STUDENT
  INSTALLMENT_PLAN
  CREDIT_LINE
  SELLER_FINANCING
  DSCR
  COMMERCIAL
  HARD_MONEY
  OTHER
}

// ─── REFERENCE RATE HISTORY ────────────────────────────────
// User-logged history of a reference rate (e.g. WSJ Prime Rate) over time —
// Sollux has no live market data feed, so this is manually maintained.
// Variable-rate loans look up the most recent entry as of their rate-reset
// date to compute their new interestRate (see Loan.rateIndex/rateMargin).
model IndexRate {
  id            String   @id @default(cuid())
  userId        String
  indexName     String // e.g. 'PRIME'
  rate          Decimal  @db.Decimal(6, 3)
  effectiveDate DateTime
  notes         String?
  createdAt     DateTime @default(now())

  @@index([userId, indexName, effectiveDate])
  @@map("index_rates")
}

// Audit trail of maturity-date extensions on a loan — e.g. a lender-granted
// option to extend a balloon/maturity out further. Each row is one exercised
// extension; Loan.maturityDate always reflects the current (latest) date.
model LoanExtension {
  id                   String    @id @default(cuid())
  loanId               String
  loan                 Loan      @relation(fields: [loanId], references: [id], onDelete: Cascade)
  months               Int // length of this extension, in months
  previousMaturityDate DateTime?
  newMaturityDate      DateTime
  notes                String?
  extendedAt           DateTime  @default(now())

  @@index([loanId])
  @@map("loan_extensions")
}

// ─── RECONCILIATION STATEMENTS ──────────────────────────────
// For a third party (e.g. a property manager) who nets multiple things
// together in one monthly statement — collects rent for a property they
// manage, deducts their management fee, and also collects payments on
// unrelated loans on the owner's behalf. A profile is the reusable mapping
// (which lease's rent, which loans, which expense category); a statement is
// one month's actual numbers against that mapping. Applying a statement
// creates the real RentPayment/LoanPayment/Expense records it represents.
model ReconciliationProfile {
  id                    String    @id @default(cuid())
  userId                String
  name                  String // e.g. "Monty James"
  propertyId            String?
  property              Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  leaseId               String? // which lease's rent this collector remits, if any
  managementFeeCategory String? // ExpenseCategory string, if this profile deducts a mgmt fee
  loanIds               Json // string[] of Loan ids this profile also collects payments for
  notes                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  statements ReconciliationStatement[]

  @@index([userId])
  @@map("reconciliation_profiles")
}

model ReconciliationStatement {
  id               String                @id @default(cuid())
  userId           String
  profileId        String
  profile          ReconciliationProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  statementDate    DateTime
  documentS3Key    String?
  documentUrl      String?
  lineItems        Json // [{ type: 'RENT'|'LOAN_PAYMENT'|'EXPENSE'|'OTHER', targetId, targetLabel, description, amount, direction: 'CREDIT'|'DEBIT' }]
  netAmount        Decimal               @db.Decimal(12, 2)
  status           String                @default("DRAFT") // DRAFT | APPLIED
  appliedAt        DateTime?
  createdRecordIds Json? // { rentPaymentIds: [], loanPaymentIds: [], expenseIds: [] } — for traceability
  notes            String?
  createdAt        DateTime              @default(now())

  @@index([userId, profileId])
  @@map("reconciliation_statements")
}

// ─── SCANNED / DIGITIZED DOCUMENTS ──────────────────────────────────────────
// Generic per-property document store — phone scans, printer imports, or
// plain uploads (bills, taxes, insurance, HOA, legal, misc mail) that don't
// belong to one of the more specific record types above. Auto-sort tries to
// point linkedType/linkedId at the record it matches; DocumentCategory.OTHER
// with no link is the fallback "Documents" bucket.
model Document {
  id         String           @id @default(cuid())
  userId     String
  propertyId String?
  property   Property?        @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  category   DocumentCategory @default(OTHER)
  title      String
  s3Key      String
  s3Url      String?
  pageCount  Int              @default(1)
  sourceType String           @default("SCAN") // SCAN | UPLOAD
  linkedType String? // 'Expense' | 'InsurancePolicy' | 'TaxAssessment' | 'UtilityAccount'
  linkedId   String?
  notes      String?
  createdAt  DateTime         @default(now())

  @@index([userId, propertyId])
  @@map("documents")
}

enum DocumentCategory {
  UTILITY
  INSURANCE
  TAX
  LEGAL
  HOA
  EXPENSE_RECEIPT
  LEASE
  APPLICATION
  IDENTITY
  SCREENING
  MAINTENANCE
  CONTRACT
  COURT_FILING
  CORRESPONDENCE
  OTHER
}

model LoanPayment {
  id                 String     @id @default(cuid())
  loanId             String
  loan               Loan       @relation(fields: [loanId], references: [id], onDelete: Cascade)
  date               DateTime
  billAmount         Decimal?   @db.Decimal(10, 2)
  amount             Decimal    @db.Decimal(10, 2)
  lateFee            Decimal?   @db.Decimal(10, 2)
  status             BillStatus @default(PAID)
  principal          Decimal?   @db.Decimal(10, 2)
  interest           Decimal?   @db.Decimal(10, 2)
  escrow             Decimal?   @db.Decimal(10, 2)
  balanceAfter       Decimal?   @db.Decimal(14, 2)
  confirmationNumber String?
  notes              String?

  @@index([loanId, date])
  @@map("loan_payments")
}

enum BillStatus {
  UNPAID
  PAID
  ON_PAYMENT_PLAN
  PAST_DUE
}

// ─── INSURANCE POLICIES ──────────────────────────────────
model InsurancePolicy {
  id               String           @id @default(cuid())
  propertyId       String
  property         Property         @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  // Set when this policy was created from (or linked to) an INSURANCE-category
  // utility account, so the two stay in sync — carrier name and active status
  // flow from the utility account; premium/dates/documents are still managed
  // here. SetNull (not Cascade) so deleting the utility account never deletes
  // policy history, only unlinks it.
  utilityAccountId String?          @unique
  utilityAccount   UtilityAccount?  @relation(fields: [utilityAccountId], references: [id], onDelete: SetNull)
  carrier          String
  policyNumber     String?
  policyType       InsuranceType    @default(PROPERTY)
  // premiumAmount is what one bill asks for at premiumFrequency. A policy
  // quoted as a year's total but paid monthly has the installment here and
  // the year's figure in termPremium — reporting the annual total as if it
  // were a monthly payment overstates cost twelvefold, and the reverse
  // understates it.
  premiumAmount    Decimal          @db.Decimal(10, 2)
  premiumFrequency PremiumFrequency @default(ANNUAL)
  // The whole term's premium, when the policy is written as a term total and
  // billed in installments. Null when premiumAmount already is the total.
  termPremium      Decimal?         @db.Decimal(10, 2)
  // Coverage, as printed on the declarations page. All optional: a liability
  // policy has no dwelling limit, a flood policy no loss-of-use.
  dwellingLimit         Decimal? @db.Decimal(12, 2)
  otherStructuresLimit  Decimal? @db.Decimal(12, 2)
  personalPropertyLimit Decimal? @db.Decimal(12, 2)
  lossOfUseLimit        Decimal? @db.Decimal(12, 2)
  liabilityLimit        Decimal? @db.Decimal(12, 2)
  medicalPaymentsLimit  Decimal? @db.Decimal(12, 2)
  deductible            Decimal? @db.Decimal(10, 2)
  // Wind/hail and named-storm deductibles are often a percentage of the
  // dwelling limit rather than a dollar figure, so both forms are kept.
  windHailDeductible    String?
  // "Guaranteed Replacement Cost", "Replacement Cost", "Actual Cash Value" —
  // free text because carriers word it differently and the wording matters.
  replacementCostBasis  String?
  agentName             String?
  agentPhone            String?
  agentEmail            String?
  namedInsured          String?
  mortgageePayee        String?
  effectiveDate    DateTime?
  expirationDate   DateTime?
  documentUrl      String?
  notes            String?
  isPersonal       Boolean          @default(false)
  isActive         Boolean          @default(true)

  @@index([propertyId])
  @@map("insurance_policies")
}

enum InsuranceType {
  PROPERTY
  LIABILITY
  FLOOD
  UMBRELLA
  OTHER
}

enum PremiumFrequency {
  MONTHLY
  ANNUAL
  SEMI_ANNUAL
}

// ─── TAX ASSESSMENTS ─────────────────────────────────────
model TaxAssessment {
  id               String    @id @default(cuid())
  propertyId       String
  property         Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  taxYear          String
  assessedValue    Decimal?  @db.Decimal(14, 2)
  annualTaxAmount  Decimal   @db.Decimal(12, 2)
  installment1Due  DateTime?
  installment2Due  DateTime?
  installment1Paid DateTime?
  installment2Paid DateTime?
  status           TaxStatus @default(UNPAID)
  notes            String?

  @@unique([propertyId, taxYear])
  @@map("tax_assessments")
}

enum TaxStatus {
  UNPAID
  PAID
  PARTIALLY_PAID
  DELINQUENT
}

// ─── IMPROVEMENTS / CAPEX ────────────────────────────────
model Improvement {
  id             String    @id @default(cuid())
  propertyId     String
  property       Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  description    String
  category       String?
  cost           Decimal   @db.Decimal(12, 2)
  contractor     String?
  startDate      DateTime?
  completionDate DateTime?
  documentUrl    String?
  notes          String?

  @@index([propertyId])
  @@map("improvements")
}

// ─── LEGAL MATTERS ───────────────────────────────────────
model LegalMatter {
  id          String      @id @default(cuid())
  propertyId  String?
  property    Property?   @relation(fields: [propertyId], references: [id])
  userId      String
  title       String
  // Free text rather than an enum: the useful taxonomy differs by state and
  // keeps growing, and a wrong enum value is a migration. The UI offers a
  // canonical list. See LEGAL_MATTER_TYPES on the frontend.
  matterType  String
  status      LegalStatus @default(OPEN)
  priority    String? // LOW | MEDIUM | HIGH | URGENT
  filedDate   DateTime?
  closedDate  DateTime?
  attorney    String?
  caseNumber  String?
  description String?
  documentUrl String?

  // Which tenancy this concerns — evictions and most disputes are about one
  // lease. SetNull so ending a lease never destroys the legal record of it.
  leaseId String?
  lease   Lease?  @relation(fields: [leaseId], references: [id], onDelete: SetNull)

  // Counsel
  attorneyFirm  String?
  attorneyEmail String?
  attorneyPhone String?

  // Court / venue
  court        String?
  jurisdiction String?
  judge        String?

  // The other side
  opposingParty   String?
  opposingCounsel String?

  // Money at stake and recovered. claimAmount is what is sought, judgment what
  // was awarded, collected what has actually been received — they diverge, and
  // the gap is the whole point of tracking a judgment.
  claimAmount      Decimal? @db.Decimal(12, 2)
  judgmentAmount   Decimal? @db.Decimal(12, 2)
  amountCollected  Decimal? @db.Decimal(12, 2)
  settlementAmount Decimal? @db.Decimal(12, 2)

  // Dates that carry consequences if missed.
  nextHearingDate DateTime?
  responseDueDate DateTime?
  statuteDeadline DateTime?

  outcome   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events LegalEvent[]
  fees   LegalFee[]

  @@index([propertyId])
  @@index([userId])
  @@index([leaseId])
  @@map("legal_matters")
}

enum LegalStatus {
  OPEN
  CLOSED
  ON_HOLD
  PENDING_FILING
  FILED
  IN_LITIGATION
  DISCOVERY
  AWAITING_HEARING
  JUDGMENT
  APPEAL
  SETTLED
  DISMISSED
  COLLECTIONS
}

// One entry on a matter's timeline: a filing, a service of process, a hearing,
// a judgment, a lockout. Kept separate from notes so dates stay queryable and
// upcoming hearings can be surfaced.
model LegalEvent {
  id            String      @id @default(cuid())
  legalMatterId String
  legalMatter   LegalMatter @relation(fields: [legalMatterId], references: [id], onDelete: Cascade)
  date          DateTime
  eventType     String // FILING | SERVICE | HEARING | MOTION | JUDGMENT | APPEAL | SETTLEMENT | LOCKOUT | NOTICE | CORRESPONDENCE | OTHER
  title         String
  notes         String?
  outcome       String?
  isCompleted   Boolean     @default(true) // false = scheduled, still ahead
  createdAt     DateTime    @default(now())

  @@index([legalMatterId, date])
  @@map("legal_events")
}

// Attorney fees, court costs, and anything else a matter costs — plus what has
// actually been paid, which is not the same thing.
model LegalFee {
  id            String       @id @default(cuid())
  legalMatterId String
  legalMatter   LegalMatter  @relation(fields: [legalMatterId], references: [id], onDelete: Cascade)
  date          DateTime
  category      String // RETAINER | HOURLY | FLAT_FEE | FILING_FEE | SERVICE_FEE | COURT_COST | EXPERT | SETTLEMENT | JUDGMENT_PAID | OTHER
  description   String?
  amount        Decimal      @db.Decimal(12, 2)
  hours         Decimal?     @db.Decimal(8, 2)
  hourlyRate    Decimal?     @db.Decimal(10, 2)
  payee         String?
  invoiceNumber String?
  isPaid        Boolean      @default(false)
  paidDate      DateTime?
  bankAccountId String?
  bankAccount   BankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  notes         String?
  createdAt     DateTime     @default(now())

  @@index([legalMatterId, date])
  @@index([bankAccountId])
  @@map("legal_fees")
}

// ─── BANK ACCOUNTS ───────────────────────────────────────
model BankAccount {
  id                   String          @id @default(cuid())
  userId               String
  user                 User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  plaidItemId          String?
  plaidItem            PlaidItem?      @relation(fields: [plaidItemId], references: [id])
  plaidAccountId       String?         @unique
  name                 String // e.g. "Fahim Chase Checking", "Dad WF Savings"
  last4                String? // e.g. "4821"
  bank                 String? // e.g. "Chase", "Wells Fargo"
  ownerLabel           String? // e.g. "Farhan", "Joint", "LLC"
  accountType          BankAccountType @default(CHECKING)
  isActive             Boolean         @default(true)
  sortOrder            Int             @default(0)
  notes                String?
  // Rent-via-P2P matching: only accounts explicitly opted in are scanned
  // for Zelle/Venmo/PayPal/Cash App-style incoming transfers. (The Plaid
  // sync cursor lives on PlaidItem, not here — it's scoped per access
  // token/Item, and one Item can have several accounts.)
  watchForRentPayments Boolean         @default(false)
  // Same idea, but for outgoing purchases: hardware-store expenses and
  // utility bill payments made from this account.
  watchForExpenses     Boolean         @default(false)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  balances             BankBalance[]
  incomingTransactions IncomingTransaction[]
  outgoingTransactions OutgoingTransaction[]
  rentPayments         RentPayment[]
  legalFees            LegalFee[]
  utilityPayments      Payment[]

  @@index([userId])
  @@index([plaidItemId])
  @@map("bank_accounts")
}

// ─── INCOMING P2P TRANSACTIONS (rent via Zelle/Venmo/PayPal/Cash App) ───────
model IncomingTransaction {
  id                 String      @id @default(cuid())
  userId             String
  user               User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankAccountId      String
  bankAccount        BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  plaidTransactionId String      @unique
  amount             Decimal     @db.Decimal(10, 2)
  date               DateTime
  name               String // Plaid's transaction name/counterparty description
  channel            String? // ZELLE | VENMO | PAYPAL | CASH_APP | APPLE_CASH | OTHER
  matchedLeaseId     String?
  matchedLease       Lease?      @relation(fields: [matchedLeaseId], references: [id], onDelete: SetNull)
  status             String      @default("UNMATCHED") // UNMATCHED | SUGGESTED | APPLIED | IGNORED
  rentPaymentId      String? // set once applied, for traceability
  createdAt          DateTime    @default(now())

  @@index([userId, status])
  @@map("incoming_transactions")
}

// ─── OUTGOING EXPENSE TRANSACTIONS (hardware stores, utility payments) ──────
model OutgoingTransaction {
  id                 String          @id @default(cuid())
  userId             String
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankAccountId      String
  bankAccount        BankAccount     @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  plaidTransactionId String          @unique
  amount             Decimal         @db.Decimal(10, 2)
  date               DateTime
  name               String // Plaid's transaction name/merchant description
  matchType          String? // HARDWARE | UTILITY
  propertyId         String?
  property           Property?       @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  utilityAccountId   String?
  utilityAccount     UtilityAccount? @relation(fields: [utilityAccountId], references: [id], onDelete: SetNull)
  category           String? // ExpenseCategory — mutable suggestion, editable before apply
  statementId        String? // an open/unpaid Statement this can mark paid instead of creating an Expense
  status             String          @default("UNMATCHED") // UNMATCHED | SUGGESTED | APPLIED | IGNORED
  appliedType        String? // EXPENSE | STATEMENT — which kind of record apply created
  appliedId          String?
  createdAt          DateTime        @default(now())

  @@index([userId, status])
  @@map("outgoing_transactions")
}

model PlaidItem {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plaidItemId     String    @unique
  accessTokenEnc  String
  institutionId   String
  institutionName String
  isActive        Boolean   @default(true)
  lastSyncedAt    DateTime?
  plaidTxCursor   String? // /transactions/sync cursor — scoped per Item
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  accounts BankAccount[]

  @@index([userId])
  @@map("plaid_items")
}

enum BankAccountType {
  CHECKING
  SAVINGS
  CREDIT_CARD
  CASH_POOL // cash on hand, Venmo, etc.
}

model BankBalance {
  id            String      @id @default(cuid())
  bankAccountId String
  bankAccount   BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  balance       Decimal     @db.Decimal(12, 2) // current/ledger balance
  available     Decimal?    @db.Decimal(12, 2) // available (current minus pending)
  creditLimit   Decimal?    @db.Decimal(12, 2)
  asOfDate      DateTime // always stored as midnight UTC for daily dedup
  source        String? // "plaid" | "manual"
  notes         String?
  createdAt     DateTime    @default(now())

  @@unique([bankAccountId, asOfDate])
  @@map("bank_balances")
}

// ─── OTHER INCOME ────────────────────────────────────────
// Non-rent income: appliance biz, SSI/govt benefits, international transfers, etc.
model OtherIncome {
  id           String              @id @default(cuid())
  userId       String
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  category     OtherIncomeCategory
  description  String?
  amount       Decimal             @db.Decimal(10, 2)
  receivedDate DateTime
  method       String? // cash, Zelle, Venmo, TapTap, check, etc.
  isRecurring  Boolean             @default(false)
  notes        String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([userId, receivedDate])
  @@map("other_income")
}

enum OtherIncomeCategory {
  APPLIANCE_SERVICE // service call fee
  APPLIANCE_DELIVERY // delivery fee
  APPLIANCE_SALE // appliance sold
  GOVERNMENT_BENEFIT // SSI, Section 8 admin fee, etc.
  INTERNATIONAL // TapTap / Bangladesh remittance received back
  LOAN_RECEIVED // personal loan received
  SECURITY_DEPOSIT // deposit collected from new tenant
  DEPOSIT_REFUND_IN // deposit returned that you previously paid
  LAUNDRY // laundry machine income
  OTHER
}
