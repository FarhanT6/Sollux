# Build-time env for the iOS shell: `npm run build:ios` reads .env.ios.
# The bundle is loaded from disk inside the app, so "/api" has nothing to
# resolve against — the API must be an absolute HTTPS URL.
VITE_API_URL=https://YOUR-BACKEND.onrender.com/api
VITE_CLERK_PUBLISHABLE_KEY=pk_live_your_clerk_publishable_key
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_key
VITE_GOOGLE_PICKER_API_KEY=your_google_picker_api_key
