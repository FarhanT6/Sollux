VITE_API_URL=http://localhost:3001/api
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_key

# Google Picker (Drive folder picker on the Import Bills page) — a plain API
# key, NOT the OAuth client secret. Create one in Google Cloud Console under
# Credentials > Create Credentials > API key, enable the "Google Picker API"
# in the API Library, and restrict the key to HTTP referrers matching your
# frontend URL (e.g. http://localhost:5173/*).
VITE_GOOGLE_PICKER_API_KEY=your_google_picker_api_key
