From 9f7ef03406ec08a1299ab4d392a962467cb8fb03 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 25 Jul 2026 20:26:51 +0000
Subject: [PATCH] fix: isolated Redis connections per worker + TLS for Upstash
 + error handlers

- Each BullMQ Queue and Worker now gets its own IORedis instance (makeConnection()).
  Sharing one connection between queues and workers causes blocking/non-blocking
  command conflicts that silently prevent workers from picking up jobs.
- Explicitly pass tls:{rejectUnauthorized:false} when REDIS_URL starts with
  rediss://, which is the Upstash TLS scheme. Render's CA bundle may not
  auto-trust the Upstash cert chain, causing silent connection failures.
- Add worker.on('error',...) handlers on all four workers so Redis connection
  errors are logged instead of crashing the process with an unhandled event.
---
 backend/src/workers/driveImportWorker.ts |  7 ++++--
 backend/src/workers/gmailWorker.ts       |  5 ++--
 backend/src/workers/insightWorker.ts     |  6 +++--
 backend/src/workers/queues.ts            | 32 +++++++++++++++++-------
 backend/src/workers/scrapeWorker.ts      |  6 +++--
 5 files changed, 39 insertions(+), 17 deletions(-)

diff --git a/backend/src/workers/driveImportWorker.ts b/backend/src/workers/driveImportWorker.ts
index f130329..369e98b 100644
--- a/backend/src/workers/driveImportWorker.ts
+++ b/backend/src/workers/driveImportWorker.ts
@@ -1,7 +1,7 @@
 import { Worker, Job } from 'bullmq';
 import { google, drive_v3 } from 'googleapis';
 import { Prisma } from '@prisma/client';
-import { redisConnection } from './queues';
+import { createWorkerConnection } from './queues';
 import { db } from '../config/db';
 import { parseBill } from '../services/pdfImportService';
 import { uploadDocument, buildStatementKey } from '../services/s3Service';
@@ -125,6 +125,8 @@ function buildRawData(ex: Awaited<ReturnType<typeof parseBill>>['extracted']) {
 const worker = new Worker<DriveImportJobData>(
   'drive-import',
   async (job: Job<DriveImportJobData>) => {
+    console.log(`[DriveImportWorker] Received job ${job.id}`);
+
     const { jobId, tokenId, folderId, fileIds, userId } = job.data;
     console.log(`[DriveImportWorker] Starting job ${jobId} for user ${userId}`);
 
@@ -274,10 +276,11 @@ const worker = new Worker<DriveImportJobData>(
       });
     }
   },
-  { connection: redisConnection, concurrency: 1 }
+  { connection: createWorkerConnection(), concurrency: 1 }
 );
 
 worker.on('completed', job => console.log(`[DriveImportWorker] Job ${job.id} completed`));
 worker.on('failed', (job, err) => console.error(`[DriveImportWorker] Job ${job?.id} failed:`, err.message));
+worker.on('error', (err) => console.error('[DriveImportWorker] Worker error:', err.message));
 
 export default worker;
diff --git a/backend/src/workers/gmailWorker.ts b/backend/src/workers/gmailWorker.ts
index 17c3b6a..e51408b 100644
--- a/backend/src/workers/gmailWorker.ts
+++ b/backend/src/workers/gmailWorker.ts
@@ -1,6 +1,6 @@
 import { Worker, Job } from 'bullmq';
 import { parseGmailForUser } from '../parsers/gmailParser';
-import { redisConnection } from './queues';
+import { createWorkerConnection } from './queues';
 
 interface GmailJobData {
   userId: string;
@@ -12,10 +12,11 @@ const worker = new Worker<GmailJobData>(
     console.log(`[GmailWorker] Parsing Gmail for user ${job.data.userId}`);
     await parseGmailForUser(job.data.userId);
   },
-  { connection: redisConnection, concurrency: 2 }
+  { connection: createWorkerConnection(), concurrency: 2 }
 );
 
 worker.on('completed', job => console.log(`[GmailWorker] Job ${job.id} completed`));
 worker.on('failed', (job, err) => console.error(`[GmailWorker] Job ${job?.id} failed:`, err.message));
+worker.on('error', (err) => console.error('[GmailWorker] Worker error:', err.message));
 
 export default worker;
diff --git a/backend/src/workers/insightWorker.ts b/backend/src/workers/insightWorker.ts
index 3548bf9..039fcf1 100644
--- a/backend/src/workers/insightWorker.ts
+++ b/backend/src/workers/insightWorker.ts
@@ -1,6 +1,6 @@
 import { Worker, Job } from 'bullmq';
 import { generateInsightsForProperty } from '../ai/insightEngine';
-import { redisConnection } from './queues';
+import { createWorkerConnection } from './queues';
 
 const worker = new Worker(
   'insights',
@@ -10,11 +10,13 @@ const worker = new Worker(
     await generateInsightsForProperty(propertyId);
     console.log(`[InsightWorker] Done for property ${propertyId}`);
   },
-  { connection: redisConnection, concurrency: 5 }
