@@ -382,4 +382,6 @@ worker.on('failed', (job, err) => {
   console.error(`[ScrapeWorker] Job ${job?.id} failed:`, err.message);
 });
 
+worker.on('error', (err) => console.error('[ScrapeWorker] Worker error:', err.message));
+
 export default worker;
